							"script": {
								"exec": [
									"pm.test('Status code es 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.token) {",
									"    pm.collectionVariables.set('jwtTokenAdmin', jsonData.token);",
									"}",
									"pm.test('Retorna token JWT y rol ADMINISTRADOR', function () {",
									"    pm.expect(jsonData.token).to.not.be.empty;",
									"    pm.expect(jsonData.rol).to.be.oneOf(['ADMINISTRADOR', 'ROLE_ADMINISTRADOR']);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
